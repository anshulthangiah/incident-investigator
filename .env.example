# Incident Investigator settings. Copy this file to .env (git-ignored) and edit.
# If there is no .env, this file is read instead, so the defaults below run the local mock stack.
# Quoted values keep a '#'; for an unquoted value, ' # comment' at the end is dropped.
# Everything dangerous is OFF by default. All data in the mock stack is invented.

# ---- Mock stack (remove or comment out both lines to use your own systems) ----
# Start the local mock backend for a generated scenario (python3 -m mock.generate --all first).
# S19 = delayed but delivered codes, S20 = API server error (needs PROBE_ENABLED), S21 = repeated requests, S22 = stopped database jobs.
MOCK_SCENARIO=S19
# MOCK_NOW is set automatically by the mock stack. Leave unset for your own systems.
# MOCK_NOW=

# ---- Language model (not needed with --demo) ----
LLM_PROVIDER=anthropic            # anthropic | openai_compatible
LLM_API_KEY=                      # an API key; a chat-app login token (sk-ant-oat...) is refused
LLM_MODEL=                        # the model name your provider documents
LLM_BASE_URL=                     # anthropic: leave empty. openai_compatible: for example https://api.openai.com/v1,
                                  # http://localhost:11434/v1 (Ollama) or http://localhost:1234/v1 (LM Studio)
LLM_TIMEOUT_S=120
LLM_TOKENS_PARAM=max_tokens       # some services want max_completion_tokens
MAX_STEPS=12                      # tool-calling steps per round
MAX_SECONDS=120                   # seconds per round
MAX_OUTPUT_TOKENS=8000            # a report that hits this is flagged as truncated
PRICE_IN_PER_MTOK=2               # your model's price per million input tokens (for the cost estimate)
PRICE_OUT_PER_MTOK=10             # per million output tokens
# Evaluation spending cap: pass --max-cost USD to evals/run_evals.py (optional, no default cap)

# ---- Delivery logs ----
LOGS_SOURCE=auto                  # auto (last 7 days live API, older from exports) | csv | api
LOGS_DIR=data/exports             # folder of exported delivery-log CSV files
PROVIDER_API_URL=                 # live log API base URL (https, or http on localhost)
PROVIDER_API_KEY=                 # key for the live log API and the credit call; never printed
REASON_GLOSSARY=data/reason_glossary.json   # replace its contents with your provider's own list of failure reasons

# ---- Credit balance ----
CREDIT_URL=                       # full URL of the balance call (GET, no query parameters)
CREDIT_KEY_HEADER=X-Api-Key       # the NAME of the request header that carries PROVIDER_API_KEY
CREDIT_PER_REQUEST=0.05           # credit used per request, for 'requests remaining'

# ---- Code changes ----
REPO_PATHS=                       # comma-separated paths of git repositories (subjects and file names are read)

# ---- Database checks (read-only, aggregate counts only) ----
DB_ENABLED=false                  # the master switch
DB_KIND=sqlite                    # sqlite | mssql | postgres (mssql needs pymssql, postgres needs psycopg)
DB_HOST=                          # host or host:port (not used by sqlite)
DB_PORT=                          # optional port
DB_NAME=                          # database name; for sqlite, the path of the file
DB_USER=
DB_PASSWORD=                      # never printed
DB_SSLMODE=prefer                 # postgres only
DB_TDS_VERSION=                   # mssql only, optional
DB_REPLICA=false                  # true if this connection is a read replica (adds a lag warning)
DB_TIMESTAMP_TZ=UTC               # UTC: the zone the accounts and sessions timestamps are stored in
DB_USERS_OBJECT=                  # empty = accounts (sqlite and mssql), public.accounts (postgres)
DB_DEVICES_OBJECT=                # empty = sessions...; 'none' switches the session lookup off
DB_QUEUE_OBJECT=                  # empty = outbox...
# Column overrides (plain names only). Defaults shown.
# DB_COL_USER_ID=id
# DB_COL_USERNAME=login_ref
# DB_COL_LOCALE=language
# DB_COL_DIAL_CODE=country_prefix
# DB_COL_ACTIVE=is_active
# DB_COL_PHONE_CONFIRMED=phone_verified
# DB_COL_CREATED=created_at
# DB_COL_UPDATED=updated_at
# DB_COL_DEV_USERID=account_id
# DB_COL_DEV_CODE_EXPIRY=code_valid_until
# DB_COL_DEV_LOGIN=last_seen_at
# DB_QCOL_CHANNEL=kind
# DB_QCOL_STATUS=state
# DB_QCOL_CREATED=created_at
# DB_QCOL_UPDATED=updated_at

# ---- Queue facts used for the clearing estimate ----
QUEUE_BATCH_SIZE=20               # rows the worker takes per channel per tick
QUEUE_TICK_S=30                   # seconds between ticks
CODE_EXPIRY_MIN=10                # minutes a code stays valid

# ---- Code API check (the probe): OFF by default ----
# Calls your verification API once with YOUR OWN test number and sends one real message.
# Needs PROBE_ENABLED=true AND your approval each run (y/N prompt, or --approve-probe).
PROBE_ENABLED=false
CODE_API_URL=                     # https, or http on localhost only
CODE_API_TOKEN=                   # optional bearer token; never printed
CODE_API_BODY_TEMPLATE=           # optional JSON using {country_prefix}, {phone}, {client}
PROBE_PHONE=999000000001          # a number YOU own (invented here)
PROBE_COUNTRY_PREFIX=+99
PROBE_CLIENT=incident-probe
PROBE_MAX_PER_RUN=2               # at most this many calls per session
PROBE_MIN_GAP_S=15                # minimum seconds between calls
PROBE_TIMEOUT_S=30                # no answer within this is reported as no_answer
PROBE_SLOW_MS=5000                # slower than this is reported as ok_but_slow
PROBE_LOG_WAIT_S=60               # how long to wait for the provider log to show the request
PROBE_LOG_POLL_S=5
PROBE_EXPECT_TEXT=Request accepted

# ---- Phone numbers ----
PHONE_LEADING_DIGITS=             # optional: if set (for example 78), a number's first national digit must be one of these

# ---- Where files go ----
# STATE_DIR=.                     # folder for sessions/, reports/, knowledge/, inputs/ and .ii_secret
# SECRET_FILE=                    # path of the per-install key file (default STATE_DIR/.ii_secret)
